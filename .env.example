# Token del bot ricevuto da @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# Chat ID destinatario (utente, gruppo o canale; per gruppi/canali inizia con -100)
TELEGRAM_CHAT_ID=-1001234567890
